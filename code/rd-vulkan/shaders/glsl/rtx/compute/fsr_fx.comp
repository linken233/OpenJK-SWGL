// Runs after AMD FSR wrote TAA_OUTPUT. It makes the other outputs of asvgf_taau:
// TAA_FX, the TAA history (TAA_A) and readback.hdr_color. It also clamps TAA_OUTPUT
// to the range of the PQ encoding, as asvgf_taau does.

#version 460
#extension GL_GOOGLE_include_directive    : enable
#extension GL_EXT_nonuniform_qualifier    : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#include "../utils.glsl"

#define GLOBAL_UBO_DESC_SET_IDX 3
#include "../global_ubo.h"

#define GLOBAL_TEXTURES_DESC_SET_IDX 1
#include "../global_textures.h"

#define VERTEX_BUFFER_DESC_SET_IDX 0
#define VERTEX_READONLY 1
#include "../vertex_buffer.h"

#include "../projection.glsl"

// The constants of asvgf_taau.comp.
const float pq_m1 = 0.1593017578125;
const float pq_m2 = 78.84375;
const float pq_c1 = 0.8359375;
const float pq_c2 = 18.8515625;
const float pq_c3 = 18.6875;
const float pq_C = 10000.0;

vec3 PQEncode(vec3 image)
{
	vec3 L = image / pq_C;
	vec3 Lm = pow(max(L, 0.0), vec3(pq_m1));
	vec3 N = (pq_c1 + pq_c2 * Lm) / (1.0 + pq_c3 * Lm);
	image = pow(N, vec3(pq_m2));

	return clamp(image, vec3(0), vec3(1));
}

void main()
{
	const ivec2 ipos = ivec2(gl_GlobalInvocationID.xy);

	if (ipos.x >= global_ubo.taa_output_width || ipos.y >= global_ubo.taa_output_height)
	{
		imageStore(IMG_TAA_OUTPUT, ipos, vec4(0));
		imageStore(IMG_TAA_FX, ipos, vec4(0));
		return;
	}

	const vec3 color = clamp(imageLoad(IMG_TAA_OUTPUT, ipos).rgb, vec3(0), vec3(pq_C));

	if (all(equal(ipos, ivec2(global_ubo.unscaled_width / 2, global_ubo.unscaled_height / 2))))
		readback.hdr_color = color;

	// The history of asvgf_taau, in case FSR stops and asvgf_taau runs the next frame.
	imageStore(IMG_TAA_A, ipos, vec4(PQEncode(color), 0));
	imageStore(IMG_TAA_OUTPUT, ipos, vec4(color, 1));

	// The accumulator of asvgf_taau for the reference mode, in case FSR stops.
	if (global_ubo.temporal_blend_factor > 0)
		imageStore(IMG_HQ_COLOR_INTERLEAVED, ipos, vec4(color, 0));

	// The weapon effects and the fog (alpha) bypass the tone mapper. The jitter of the render is taken out of the position, and
	// the four render pixels around it are mixed.
	{
		const vec2 fx_pos = clamp(hires_to_lores(ipos), vec2(0.0), vec2(global_ubo.width - 1, global_ubo.height - 1));
		const ivec2 fx_p0 = ivec2(floor(fx_pos));
		const ivec2 fx_p1 = min(fx_p0 + ivec2(1), ivec2(global_ubo.width - 1, global_ubo.height - 1));
		const vec2 fx_w = fx_pos - vec2(fx_p0);

		const vec4 fx = mix(mix(texelFetch(TEX_FLAT_FX, ivec2(fx_p0.x, fx_p0.y), 0), texelFetch(TEX_FLAT_FX, ivec2(fx_p1.x, fx_p0.y), 0), fx_w.x),
							mix(texelFetch(TEX_FLAT_FX, ivec2(fx_p0.x, fx_p1.y), 0), texelFetch(TEX_FLAT_FX, ivec2(fx_p1.x, fx_p1.y), 0), fx_w.x), fx_w.y);

		imageStore(IMG_TAA_FX, ipos, fx);
	}
}
