///----------------------------------------------------------------------------------------------
/// Phys editor: creates and edits the .phys file of the player model in game.
/// Open it with the console command ph_menu. Logic: code/ui/ui_phys.cpp
///----------------------------------------------------------------------------------------------
{
	menuDef
	{
		name					"physEdit"
		fullScreen				1
		rect					0 0 640 480
		visible					1
		focusColor				1 1 1 1

		onOpen
		{
			uiScript			physOpen
			hide				usedTab
			hide				boneTab
			show				unusedTab
			hide				colliderTab
			hide				helpTab
			show				settingsTab
		}

		onESC
		{
			uiScript			physRevert
			uiScript			physClearHighlight
			uiScript			physClose
			close				all
			uiScript			closeingame
		}

///----------------------------------------------------------------------------------------------
/// Background, title and preview (the preview is painted first, so it stays behind the panels)
///----------------------------------------------------------------------------------------------
		itemDef
		{
			name				background
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			background			"gfx/menus/characterbackground"
			forecolor			1 1 1 1
			visible				1
			decoration
		}

		itemDef
		{
			name				character
			type				ITEM_TYPE_MODEL
			rect				182 36 270 370
			model_g2anim		"BOTH_STAND1"
			asset_model			"ui_char_model"
			model_angle			180
			model_g2mins		-20 -15 -10
			model_g2maxs		20 15 45
			model_rotation		0
			model_fovx			50
			model_fovy			50
			cvar				ui_char_model_angle
			isCharacter			1
			visible				1
			decoration
		}

		itemDef
		{
			name				character_control
			type				ITEM_TYPE_MODEL_CONTROL
			rect				182 36 270 370
			modelTarget			character
			cvar				ui_char_model_angle
			visible				1
		}

		itemDef
		{
			name				titleBack
			style				WINDOW_STYLE_SHADER
			background			"gfx/menu/w_bg_np.tga"
			backgroundStyle		BACKGROUND_NINE_PATCH_STRETCH
			backgroundOffset	4 3 3 4
			rect				11 6 618 26
			forecolor			1 1 1 1
			visible				1
			decoration
		}

		itemDef
		{
			name				title
			text				"PHYS EDITOR"
			style				WINDOW_STYLE_EMPTY
			rect				11 6 618 26
			font				3
			textscale			1
			textalign			ITEM_ALIGN_CENTER
			textalignx			309
			textaligny			1
			forecolor			0.87 0.61 0 1
			visible				1
			decoration
		}

///----------------------------------------------------------------------------------------------
/// Left: surfaces, groups and bones
///----------------------------------------------------------------------------------------------
		itemDef
		{
			name				tabUnused
			text				"Unused"
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			background			"gfx/menu/w_btn_bg.tga"
			rect				11 38 56 22
			font				2
			textscale			0.7
			textalign			ITEM_ALIGN_CENTER
			textalignx			28
			textaligny			3
			forecolor			0.89 0.45 0 1
			visible				1
			action
			{
				play			"sound/interface/button1.wav"
				uiScript		physClearHighlight
				hide			usedTab
				hide			boneTab
				show			unusedTab
			}
		}

		itemDef
		{
			name				tabUsed
			text				"Used"
			type				ITEM_TYPE_BUTTON
