			rect				125 38 56 22
			font				2
			textscale			0.7
			textalign			ITEM_ALIGN_CENTER
			textalignx			28
			textaligny			3
			forecolor			0.89 0.45 0 1
			visible				1
			action
			{
				play			"sound/interface/button1.wav"
				uiScript		physClearHighlight
				hide			unusedTab
				hide			usedTab
				show			boneTab
				uiScript		physBonesOn
			}
		}

		// Unused surfaces of the model
