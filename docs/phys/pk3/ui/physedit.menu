			visible				1
			action
			{
				play			"sound/interface/button1.wav"
				uiScript		physClearHighlight
				hide			unusedTab
				hide			boneTab
				show			usedTab
			}
		}

		itemDef
		{
			name				tabBones
			text				"Bones"
			type				ITEM_TYPE_BUTTON
