			backcolor			.04 .02 0 .8
			bordercolor			1 .682 0 .6
			outlinecolor		1 .682 0 .35
			forecolor			1 .682 0 1
			descText			"The surfaces of the model without a group"
			visible				1
			action
			{
				play			"sound/interface/button1.wav"
			}
		}

		itemDef
		{
			name				buttonAdd
			group				unusedTab
			text				"Add"
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_SHADER
			background			"gfx/menu/w_btn_bg.tga"
			rect				11 398 170 26
			font				2
			textscale			0.9
			textalign			ITEM_ALIGN_CENTER
			textalignx			85
			textaligny			4
			forecolor			0.89 0.45 0 1
			descText			"Makes a group of the selected surface. It appears in Used."
			visible				1
			action
			{
